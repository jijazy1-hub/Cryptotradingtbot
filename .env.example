# ─── CryptoBot V2 configuration ───────────────────────────────────────────────
# Copy to .env for local runs; add the same names in Vercel → Settings → Environment Variables.

# Coins for the multi-timeframe scanner (comma-separated Binance USDT pairs)
BINANCE_SYMBOLS=SOLUSDT,BTCUSDT,ETHUSDT,BNBUSDT,XRPUSDT,ADAUSDT,AVAXUSDT,LINKUSDT,NEARUSDT,INJUSDT,SUIUSDT,ARBUSDT

# ─── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Your own chat id — this account is the bot admin
TELEGRAM_CHAT_ID=your_chat_id
# Optional shared channel for MARKET-WIDE alerts (scanner BUYs, listings).
# Personal position alerts never go here.
TELEGRAM_INFO_CHANNEL_ID=
# Bot username without @ (used for invite links)
BOT_USERNAME=JijazyBot

# ─── Security (REQUIRED — set both) ───────────────────────────────────────────
# Any long random string, e.g. output of:  openssl rand -hex 32
# Protects cron/alert endpoints. Call them as  /api/v2monitor?key=THIS_VALUE
CRON_SECRET=
# Letters, numbers, _ and - only. After setting it, open
# /api/set-commands?key=CRON_SECRET once so Telegram starts sending it.
TELEGRAM_WEBHOOK_SECRET=

# ─── Storage (Upstash Redis) ─────────────────────────────────────────────────
# Without these, users/positions/trades live in memory and are lost on restart.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Optional ─────────────────────────────────────────────────────────────────
# Minimum moonshot score for /api/v2moonshot alerts (default 70)
MOONSHOT_MIN_SCORE=70
# Override the site URL used when registering the webhook
PUBLIC_BASE_URL=https://crptotradingbot.vercel.app
# Local scheduler (node scheduler.js)
CRON_SCHEDULE=0 * * * *

# Free access for small accounts when paid access is on (USD Binance Spot balance; 0 = off).
# The admin can change it in the bot (💳 Subscriptions). Default 100.
# FREE_ACCOUNT_LIMIT_USD=100

# 💬 Ask the bot (AI helper — explains, never trades). Set ONE of these keys:
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# AI_PROVIDER=openai          # only if both keys are set
# AI_MODEL=gpt-4.1-mini       # default: gpt-4.1-mini (OpenAI) / claude-haiku-5-5 (Anthropic)
# AI_DAILY_LIMIT=20           # questions per user per day (the admin has no limit)

# ─── v2.23 auto-buy settings (not secret) ─────────────────────────────────────
# Which coins: ALL = every liquid Binance USDT coin (found fresh each day), or a list like BTC,ETH,SOL
AUTOBUY_UNIVERSE=ALL
# Ignore coins that traded less than this many USD in the last 24h (0 = no floor, thin coins included)
AUTOBUY_MIN_VOLUME_USD=1000000
# Look at most this many coins, most-traded first
AUTOBUY_MAX_COINS=400
# true = sell every auto-bought position at the daily run (00:05 UTC); false = hold until the trailing stop
AUTOBUY_DAILY_CLOSE=true
